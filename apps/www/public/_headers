# Agent discovery links on the homepage — RFC 8288 (Web Linking).
# SAK has no HTTP API, so there is deliberately no rel="api-catalog" here; the
# links below all resolve to something that actually exists.
/
  Link: <https://sak.coody.app/>; rel="canonical", </sitemap.xml>; rel="sitemap"; type="application/xml", <https://github.com/coodyapp/sak#readme>; rel="service-doc"; type="text/html", <https://github.com/coodyapp/sak/blob/main/LICENSE>; rel="license", <https://coody.app>; rel="author"

# Serve the agent-facing files as their real media types, never as the SPA
# shell. Both are cheap to regenerate, so keep the cache short.
/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600
